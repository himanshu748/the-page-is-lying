{
  "name": "the-page-is-lying",
  "version": "0.1.0",
  "private": true,
  "description": "Forge app for Confluence that checks runbook claims against code and cites file and line.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p static/ui/tsconfig.json",
    "demo": "vite --config static/ui/vite.config.ts --host 127.0.0.1 --open /local-demo.html",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ui": "vite build --config static/ui/vite.config.ts",
    "build:demo": "vite build --config static/ui/vite.config.ts --mode judge-demo",
    "test:e2e": "playwright test",
    "forge:lint": "forge lint"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/events": "^3.0.10",
    "@forge/kvs": "^2.1.2",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
