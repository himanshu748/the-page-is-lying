{
  "version": 1,
  "type": "doc",
  "content": [
    {
      "type": "heading",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "type": "text",
          "text": "Payments API runbook"
        }
      ]
    },
    {
      "type": "bodiedExtension",
      "attrs": {
        "extensionType": "com.atlassian.ecosystem",
        "extensionKey": "runbook-check",
        "layout": "default"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "To take a payment, call "
            },
            {
              "type": "text",
              "text": "POST /v2/payments",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " with the amount in cents."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "To look up a payment, call "
            },
            {
              "type": "text",
              "text": "GET /v2/payments/{id}",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Set "
            },
            {
              "type": "text",
              "text": "STRIPE_KEY",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " before starting the service."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Run "
            },
            {
              "type": "text",
              "text": "npm run db:migrate",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " before each deploy."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "To force a refund, run "
            },
            {
              "type": "text",
              "text": "payments refund <paymentId> --force",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Reconcile with "
            },
            {
              "type": "text",
              "text": "ledgerctl reconcile --since 24h",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ]
    }
  ]
}