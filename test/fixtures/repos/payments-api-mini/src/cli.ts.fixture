import { Command } from 'commander';

const program = new Command();
program.name('payments').description('Payments admin CLI').version('1.0.0');

program
  .command('refund <paymentId>')
  .description('Refund a payment')
  .option('--confirm', 'confirm the refund')
  .option('-r, --reason <text>', 'reason for the refund')
  .action(() => undefined);

program.command('list').option('--limit <n>').action(() => undefined);

program.parse();
